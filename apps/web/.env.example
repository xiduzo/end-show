# ─────────────────────────────────────────────────────────────
# end-show — WEB environment
#
# For local development, copy this file to ".env" in this folder:
#     cp .env.example .env
#
# IMPORTANT: this value is baked into the JavaScript bundle at BUILD time, not
# read at runtime. When building the Docker image you must pass it as a build
# argument instead (see ../../docs/DEPLOYMENT.md):
#     docker build -f Dockerfile.web \
#       --build-arg VITE_SERVER_URL=https://api.your-domain.example .
# ─────────────────────────────────────────────────────────────

# Public URL of the end-show server (no trailing slash).
#   Local:       http://localhost:3000
#   Production:  https://api.your-domain.example
VITE_SERVER_URL=http://localhost:3000
