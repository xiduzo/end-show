# end-show printer — local config.
# Copy to .env and uncomment what you need:  cp .env.example .env
#
# Precedence: a real exported env var (start-show.sh / launchd plist) ALWAYS
# wins over .env. .env is for convenient local overrides on the printer host.
# .env is gitignored; this example file is committed.

# --- Backend -----------------------------------------------------------------
# auto | usb | bluetooth | serial | file | dummy
# auto tries usb first, then a paired bluetooth serial port.
# dummy = no hardware (useful to test the HTTP service without a printer).
#PRINTER_BACKEND=bluetooth

# --- Bluetooth (BACKEND=bluetooth) -------------------------------------------
# macOS exposes the paired printer as /dev/cu.<Name>. The NT-1809DD advertises
# the generic name "BlueToothPrinter" -> /dev/cu.BlueToothPrinter.
# The node ONLY exists while the printer is powered on and connected.
#
# Pin the exact port to skip auto-discovery entirely (most reliable):
#PRINTER_BT_DEVICE=/dev/cu.BlueToothPrinter
#
# ...or let discovery pick it: a case-insensitive substring of the port name.
#PRINTER_BT_HINT=printer
#PRINTER_BT_BAUDRATE=9600

# --- USB (BACKEND=usb) -------------------------------------------------------
# Find with: system_profiler SPUSBDataType  (macOS)  /  lsusb  (Linux)
#PRINTER_USB_VENDOR=0x0416
#PRINTER_USB_PRODUCT=0x5011

# --- Serial (BACKEND=serial) / File (BACKEND=file) ---------------------------
#PRINTER_SERIAL_DEVICE=/dev/rfcomm0
#PRINTER_SERIAL_BAUDRATE=9600
#PRINTER_FILE_DEVICE=/dev/usb/lp0

# --- HTTP service ------------------------------------------------------------
#PRINTER_HTTP_HOST=0.0.0.0
#PRINTER_HTTP_PORT=8765
# Comma-separated allowed browser origins, * = any (LAN kiosk default).
#PRINTER_CORS_ORIGINS=*
# Hot reload on source changes (dev only).
#PRINTER_RELOAD=0

# --- Receipt layout / imaging ------------------------------------------------
#PRINTER_DOTS=384
#PRINTER_CHARS=32
# Tall images are sent in strips so the printer's small buffer doesn't overrun.
#PRINTER_IMAGE_STRIP=240
#PRINTER_IMAGE_DELAY_MS=120
# bitImageRaster | bitImageColumn | graphics — switch if portraits print garbled.
#PRINTER_IMAGE_IMPL=bitImageRaster
