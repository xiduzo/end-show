# ─────────────────────────────────────────────────────────────
# end-show — SERVER environment
#
# Copy this file to ".env" in this same folder, then fill in the values:
#     cp .env.example .env
#
# Lines starting with "#" are comments / disabled. Remove the "#" to enable.
# Full walkthrough: ../../docs/DEPLOYMENT.md
# ─────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ──────────────────────────────────────
# Where the SQLite / libsql database lives. Pick ONE style:
#   Local file (simplest):    file:./local.db
#   Turso (hosted libsql):    libsql://YOUR-DB.turso.io   (+ set LIBSQL_AUTH_TOKEN)
#   Self-hosted sqld server:  http://USER:PASSWORD@your-db-host:8080
DATABASE_URL=file:./local.db

# Auth token for Turso / hosted libsql. Leave blank for a local file or for a
# self-hosted server that uses the USER:PASSWORD@ form above.
# LIBSQL_AUTH_TOKEN=

# Folder the server reads migration files from. The Docker image sets this for
# you; only change it if you run the server outside Docker.
# MIGRATIONS_DIR=./migrations

# ── Login / sessions (REQUIRED) ──────────────────────────────
# A long random secret, 32+ characters. Generate one with:
#     openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-plus-character-random-string

# The PUBLIC address where THIS server is reachable (no trailing slash).
#   Local:       http://localhost:3000
#   Production:  https://api.your-domain.example
BETTER_AUTH_URL=http://localhost:3000

# Which website origins are allowed to talk to this server. Comma-separated,
# full URLs, no trailing slash. Must match the web app's public address exactly.
#   Local:       http://localhost:5173
#   Production:  https://your-domain.example
CORS_ORIGIN=http://localhost:5173

# development | production | test
# NOTE: "development" auto-seeds ~50 demo students on first boot.
#       Use "production" for a real show (seeds only the staff account below).
NODE_ENV=development

# ── File storage — Cloudflare R2 (OPTIONAL) ──────────────────
# Needed for portrait / work-media uploads. Leave blank and the app still runs,
# but students cannot upload images or video. All five must be set together.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Public base URL that serves the files back (R2 public dev URL or custom domain).
# R2_PUBLIC_URL=https://assets.your-domain.example

# Storage budget knobs, in bytes. Defaults shown.
# BUDGET_DEFAULT_BYTES=31457280         # 30 MB starting budget per student
# BUDGET_TRANSFER_FLOOR_BYTES=5242880   #  5 MB floor when students gift budget

# ── Email — Resend (OPTIONAL) ────────────────────────────────
# Sends the 6-digit login codes. If RESEND_API_KEY is blank, codes are printed
# to the SERVER LOGS instead of being emailed (fine for testing, not a show).
# RESEND_API_KEY=
# RESEND_FROM=Graduation Show <onboarding@resend.dev>

# ── First staff account (seeded on first boot) ───────────────
# This email becomes the initial Staff login. To get into the admin the first
# time, request a login code for this address.
ROOT_STAFF_EMAIL=you@your-domain.example
ROOT_STAFF_NAME=Your Name
